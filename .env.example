EQUITY_DATABASE_URL=postgresql+psycopg://equity:equity_local_dev@127.0.0.1:5433/equity
EQUITY_TEST_DATABASE_URL=postgresql+psycopg://equity:equity_local_dev@127.0.0.1:5433/equity_test

# Raw source files (MinIO locally)
EQUITY_BLOB_ENDPOINT_URL=http://127.0.0.1:9000
EQUITY_BLOB_ACCESS_KEY=equity
EQUITY_BLOB_SECRET_KEY=equity_local_dev

# Data-source switches. Every adapter is off until its own flag is true;
# web_scrape adapters also need the master switch.
EQUITY_DEPLOYMENT_MODE=personal
EQUITY_WEB_SCRAPING_ENABLED=false
# EQUITY_SOURCE_<NAME>_ENABLED=true
# EQUITY_DROP_FOLDER=./drop
