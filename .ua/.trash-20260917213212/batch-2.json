      "tags": ["service", "api-handler", "data-pipeline"],
      "complexity": "complex",
      "languageNotes": "The Tally dataclass accumulates run statistics and converts them to a RunResult; the two adapter classes share load_bhavcopy and reparse_stored_bhavcopy as module-level helpers."
    },
