{
  "nodes": [
    {
      "id": "file:core/db/base.py",
      "type": "file",
      "name": "base.py",
      "filePath": "core/db/base.py",
      "summary": "Defines the SQLAlchemy declarative Base and the ProvenanceMixin that attaches as_of, content_hash, source_url, extracted_by, model_version, and ingested_at columns to every store table, enforcing timezone-aware as_of before flush.",
      "tags": ["data-model", "utility", "validation"],
      "complexity": "simple",
      "languageNotes": "ProvenanceMixin uses a SQLAlchemy @validates event to reject naive datetimes before they reach the database, making the constraint ORM-level rather than DB-constraint-only."
    },
    {
      "id": "file:core/db/models.py",
      "type": "file",
      "name": "models.py",
      "filePath": "core/db/models.py",
      "summary": "Central ORM model registry defining all store tables: financial facts, raw source files, entity/ISIN mapping, index snapshots and their quarantine, and NSE bhavcopy rows and quarantine, all inheriting ProvenanceMixin for append-only temporal semantics.",
      "tags": ["data-model", "database", "schema-definition"],
      "complexity": "complex",
      "languageNotes": "Uses a _pg_enum helper to bind Python enums to named Postgres ENUM types, keeping SQL migrations deterministic."
    },
    {
      "id": "file:core/db/pit.py",
      "type": "file",
      "name": "pit.py",
      "filePath": "core/db/pit.py",
      "summary": "Provides the complete set of point-in-time read functions for all stores; every function accepts an as_of parameter and enforces that only data visible at that wall-clock time is returned, preventing look-ahead bias.",
      "tags": ["data-model", "service", "validation"],
      "complexity": "complex",
      "languageNotes": "All functions call require_aware on every datetime argument and use SQLAlchemy's .distinct().order_by() pattern to pick the latest-as-of version of each logical row without window functions."
    },
    {
      "id": "file:core/timezones.py",
      "type": "file",
      "name": "timezones.py",
      "filePath": "core/timezones.py",
      "summary": "Exports require_aware, a one-function module that raises ValueError on any naive datetime, enforcing the system-wide rule that all timestamps must carry a timezone offset.",
      "tags": ["utility", "validation"],
      "complexity": "simple"
    },
